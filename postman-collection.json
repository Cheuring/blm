{
  "info": {
    "name": "饱了么微服务API测试",
    "description": "饱了么外卖平台微服务架构API测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "认证相关",
      "item": [
        {
          "name": "用户登录",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.accessToken) {",
                  "        pm.collectionVariables.set('access_token', response.data.accessToken);",
                  "        pm.collectionVariables.set('refresh_token', response.data.refreshToken);",
                  "        console.log('Token saved:', response.data.accessToken);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/auth/login",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "刷新Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/auth/refresh?refreshToken={{refresh_token}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "refresh"],
              "query": [
                {
                  "key": "refreshToken",
                  "value": "{{refresh_token}}"
                }
              ]
            }
          }
        },
        {
          "name": "验证Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/auth/validate?token={{access_token}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "validate"],
              "query": [
                {
                  "key": "token",
                  "value": "{{access_token}}"
                }
              ]
            }
          }
        },
        {
          "name": "用户登出",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/auth/logout?token={{access_token}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "auth", "logout"],
              "query": [
                {
                  "key": "token",
                  "value": "{{access_token}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "用户管理",
      "item": [
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"newuser\",\n    \"password\": \"password123\",\n    \"phone\": \"13900000000\",\n    \"email\": \"newuser@example.com\",\n    \"fullName\": \"新用户\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/users/register",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "register"]
            }
          }
        },
        {
          "name": "获取当前用户信息",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/users/profile",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "profile"]
            }
          }
        },
        {
          "name": "更新用户信息",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"testuser\",\n    \"phone\": \"13800000002\",\n    \"email\": \"updated@example.com\",\n    \"fullName\": \"更新后的用户名\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/users/profile",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "地址管理",
      "item": [
        {
          "name": "获取地址列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/users/addresses",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "addresses"]
            }
          }
        },
        {
          "name": "添加地址",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"receiver\": \"王五\",\n    \"phone\": \"13900000000\",\n    \"province\": \"广东省\",\n    \"city\": \"深圳市\",\n    \"district\": \"南山区\",\n    \"detailAddress\": \"科技园南区\",\n    \"isDefault\": 0\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/users/addresses",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "addresses"]
            }
          }
        },
        {
          "name": "更新地址",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"receiver\": \"王五(更新)\",\n    \"phone\": \"13900000001\",\n    \"province\": \"广东省\",\n    \"city\": \"深圳市\",\n    \"district\": \"南山区\",\n    \"detailAddress\": \"科技园南区(更新)\",\n    \"isDefault\": 1\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/users/addresses/1",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "addresses", "1"]
            }
          }
        },
        {
          "name": "设置默认地址",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/users/addresses/1/default",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "addresses", "1", "default"]
            }
          }
        },
        {
          "name": "删除地址",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/users/addresses/1",
              "host": ["{{gateway_url}}"],
              "path": ["api", "users", "addresses", "1"]
            }
          }
        }
      ]
    }
  ]
}
