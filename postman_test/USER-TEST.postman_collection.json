		{
			"name": "用户注册",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// 生成唯一的用户名和手机号\r",
							"const randomSuffix = Math.floor(Math.random() * 10000);\r",
							"pm.environment.set('password', '123456');\r",
							"pm.environment.set('username', 'testuser' + randomSuffix);\r",
							"pm.environment.set('phone', '138' + Math.floor(Math.random() * 100000000).toString().padStart(8, '0'));\r",
							"pm.environment.set('email', `test${randomSuffix}@example.com`);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response has user data\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.have.property('data');\r",
							"    pm.expect(jsonData.data).to.have.property('id');\r",
							"    pm.expect(jsonData.data).to.have.property('username');\r",
							"    \r",
							"    // 保存用户ID\r",
							"    pm.environment.set('userId', jsonData.data.id);\r",
							"});\r",
							"\r",
							"pm.test(\"User role is RIDER\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.data.role).to.eql('RIDER'); \r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
