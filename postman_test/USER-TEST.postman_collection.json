	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"// Collection Pre-request Script\r",
					"// 设置默认headers\r",
					"pm.request.headers.add({\r",
					"    key: 'Content-Type',\r",
					"    value: 'application/json'\r",
					"});\r",
					"\r",
					"// 如果有token，自动添加Authorization header\r",
					"const token = pm.environment.get('token');\r",
					"if (token && token !== '') {\r",
					"    pm.request.headers.add({\r",
					"        key: 'Authorization',\r",
					"        value: `Bearer ${token}`\r",
					"    });\r",
					"}\r",
					"\r",
					"// 通用函数：生成随机字符串\r",
					"pm.globals.set('generateRandomString', function(length = 8) {\r",
					"    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';\r",
					"    let result = '';\r",
					"    for (let i = 0; i < length; i++) {\r",
					"        result += chars.charAt(Math.floor(Math.random() * chars.length));\r",
					"    }\r",
					"    return result;\r",
					"});\r",
					"\r",
					"// 通用函数：生成随机手机号\r",
					"pm.globals.set('generateRandomPhone', function() {\r",
					"    return '138' + Math.floor(Math.random() * 100000000).toString().padStart(8, '0');\r",
					"});\r",
					"\r",
					"// 设置测试数据\r",
					"pm.globals.set(\"testStoreId\", \"1\");\r",
					"pm.globals.set(\"testFoodId\", \"1\");\r",
					"pm.globals.set(\"testPromotionId\", \"1\");\r",
					"pm.globals.set(\"testCategoryId\", \"1\");\r",
					"pm.globals.set(\"testOrderId\", \"1\");"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"// Collection Tests - 在每个请求后执行\r",
					"pm.test(\"Response time is less than 5000ms\", function () {\r",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
					"});\r",
					"\r",
					"pm.test(\"Response is JSON\", function () {\r",
					"    pm.response.to.be.json;\r",
					"});\r",
					"\r",
					"// 检查通用错误\r",
					"if (pm.response.code >= 400) {\r",
					"    pm.test(\"Error response has message\", function () {\r",
					"        const jsonData = pm.response.json();\r",
					"        pm.expect(jsonData).to.have.property('message');\r",
					"    });\r",
					"}"
